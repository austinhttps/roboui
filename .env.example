# RoboUI Environment Configuration
# Toggle mock mode (true avoids loading local model weights)
ROBOUI_MOCK_MODE=true

# Context window throttling (tokens)
ROBOUI_MAX_CONTEXT_TOKENS=2048

# GPU layers offloaded to VRAM (0 for CPU only)
ROBOUI_N_GPU_LAYERS=0

# Local GGUF model path
ROBOUI_MODEL_PATH=models/gemma-2b-instruct-q4.gguf

# Air-gapped sandbox policies
ROBOUI_INLINED_TAILWIND=true
ROBOUI_ENFORCE_CSP=true
